# Required public Supabase configuration for the browser app.
# These are Vite-exposed public values; do not place service-role keys or secrets here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Playwright test accounts (leave values blank in committed files).
E2E_CREATOR_EMAIL=
E2E_CREATOR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_BASE_URL=
